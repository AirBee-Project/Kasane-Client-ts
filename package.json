{
  "name": "@airbee-project/kasane-client",
  "version": "0.10.0",
  "description": "kasane-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirBee-Project/Kasane-TypeScript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "bun@1.3.11",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "imports": {
    "#kasane-wasm": {
      "kasane-source": "./src/client/wasm/inline.ts",
      "workerd": "./dist/wasm/workerd.js",
      "import": "./dist/wasm/inline.js",
      "require": "./dist/wasm/inline.cjs",
      "default": "./dist/wasm/inline.js"
    }
  },
  "files": [
    "dist",
    "!dist/wasm/*.map",
    "src",
    "!src/client/wasm/gen",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun run playground/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "fmt": "biome format --write .",
    "check": "tsc --noEmit && biome check .",
    "ci": "tsc --noEmit && biome check . && bun run docs:check && bun run test",
    "test": "bun test --conditions kasane-source",
    "test:watch": "bun test --conditions kasane-source --watch",
    "generate": "bun scripts/generate.ts",
    "docs": "bun scripts/docs-serve.ts",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors"
  },
  "keywords": [],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "browser-sync": "^3.0.4",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2"
  }
}
