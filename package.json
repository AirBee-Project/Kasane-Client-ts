{
  "name": "@airbee-project/kasane-client",
  "version": "0.0.3",
  "description": "kasane-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirBee-Project/Kasane-TypeScript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun run playground/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "fmt": "biome format --write .",
    "check": "tsc --noEmit && biome check .",
    "ci": "tsc --noEmit && biome check . && bun test",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "codegen": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es.exe --es_out=src/client/gen --es_opt=target=ts --proto_path=proto proto/auth.proto proto/common.proto proto/data.proto proto/database.proto proto/query.proto proto/system.proto proto/table.proto proto/users.proto"
  },
  "keywords": [],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "tsup": "^8.5.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2"
  }
}
